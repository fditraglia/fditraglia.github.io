#!/bin/sh
# Runs before every commit in this repo (enabled by `rake hooks`).
# Stops the commit if _data/papers.yml has a mistake or if research.md has been recreated.
# To commit anyway: git commit --no-verify
cd "$(git rev-parse --show-toplevel)" || exit 1
if ! rake check; then
  echo
  echo "Commit stopped by hooks/pre-commit. Fix the problem above and commit again."
  exit 1
fi
